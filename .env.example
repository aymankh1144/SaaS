APP_NAME=MenuSaaS
APP_ENV=local
APP_KEY=
# في الإنتاج: APP_ENV=production و APP_DEBUG=false (لا تترك التصحيح مفعلاً أبداً)
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Damascus
APP_LOCALE=ar

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL (الافتراضي). للتجربة السريعة بدون MySQL استخدم:
#   DB_CONNECTION=sqlite  ثم  touch database/database.sqlite  واحذف باقي أسطر DB_*
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=menusaas
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# في الإنتاج عبر HTTPS فعّل:
# SESSION_SECURE_COOKIE=true

# ── أدمن المنصة ──────────────────────────────────────────────
# لا توجد قيم افتراضية؛ بدونها لا يمكن تسجيل دخول الأدمن.
# ولّد الهاش بالأمر:
#   php artisan tinker --execute="echo Hash::make('كلمة-مرور-قوية');"
# وضعه بين علامتي اقتباس مفردتين لأنه يحتوي على علامة $
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
